// JSON API: app status + the daemon health route.

type Status struct {
    status  string
    port    int
    uptime  int
    version string
}

func version() (v) { v = "1.0.0" }

func status_json(port, start) (j) {
    s := Status{"running", port, now() - start, version()}
    j = json(s)
}

// health_json is the cli-daemon-spec §2 shape: {ok, service, pid}. Keep it
// cheap — no database round trip, no dependency check.
func health_json(port) (j) {
    j = "{\"ok\":true,\"service\":\"boilerplate-cli-ui-machin\",\"pid\":" + str(getpid()) + ",\"port\":" + str(port) + "}"
}
