// The embedded guide and command catalog (cli-guide-spec, cli-output-spec §4).
//
// Compiled into the binary — an agent landing on a machine with this binary and
// no network can still learn the tool. Never fetch this at runtime.

func guide_json() (s) {
    s = "{"
    s = s + "\"boilerplate-cli-ui-machin\":\"A CLI with an embedded web UI, in machin (MFL), compiled to one native binary.\","
    s = s + "\"version\":\"" + version() + "\","
    s = s + "\"one_liner\":\"Starts an HTTP server that serves a React dashboard at / and a JSON API at /api/*, from a single ~30 kB binary that links only libc — the CLI, the server and the UI all ship in one file.\","
    s = s + "\"model\":{"
    s = s + "\"binary\":\"one native executable: no runtime, no interpreter, no node_modules. The UI is a string compiled into it.\","
    s = s + "\"server\":\"a self-contained HTTP server (listen/accept/route), one goroutine per connection.\","
    s = s + "\"daemon\":\"fork/setsid through the C FFI, with /_health as the source of truth for whether it is up.\","
    s = s + "\"contract\":\"agent-first: data on stdout, context on stderr, semantic exit codes, typed errors, an embedded guide.\""
    s = s + "},"
    s = s + "\"loop\":["
    s = s + "\"./build.sh — embed ui/index.html, compose the MFL sources, compile to native\","
    s = s + "\"./boilerplate-cli-ui-machin serve — foreground on 127.0.0.1:8080\","
    s = s + "\"open http://127.0.0.1:8080/ for the UI, or curl /api/status for JSON\","
    s = s + "\"./boilerplate-cli-ui-machin daemon start — background it instead\","
    s = s + "\"./boilerplate-cli-ui-machin daemon stop — stop it\""
    s = s + "],"
    s = s + "\"concepts\":{"
    s = s + "\"embedded UI\":\"build.sh turns ui/index.html into an MFL string function (src/ui_gen.src) — machin's equivalent of go:embed. Edit the HTML, rerun build.sh.\","
    s = s + "\"loopback default\":\"serve binds 127.0.0.1 unless --host says otherwise. Binding the whole network is deliberate, never accidental.\","
    s = s + "\"shutdown token\":\"off-loopback, POST /_shutdown requires X-Shutdown-Token matching $SHUTDOWN_TOKEN, or it answers 403 and keeps running.\","
    s = s + "\"exit codes\":\"0 ok, 80-89 input, 90-99 state, 100-109 external, 110-119 internal. The code equals .error.code in the body.\""
    s = s + "},"
    s = s + "\"commands\":{\"server\":["
    s = s + "\"boilerplate-cli-ui-machin serve [--host H] [--port N]\","
    s = s + "\"boilerplate-cli-ui-machin daemon start [--port N]\","
    s = s + "\"boilerplate-cli-ui-machin daemon stop [--port N]\","
    s = s + "\"boilerplate-cli-ui-machin daemon status [--port N]\""
    s = s + "],\"introspection\":["
    s = s + "\"boilerplate-cli-ui-machin guide [--human]\","
    s = s + "\"boilerplate-cli-ui-machin help-json\","
    s = s + "\"boilerplate-cli-ui-machin version [--json]\""
    s = s + "]},"
    s = s + "\"examples\":["
    s = s + "{\"goal\":\"serve the UI on a custom port\",\"do\":[\"./boilerplate-cli-ui-machin serve --port 3000\"]},"
    s = s + "{\"goal\":\"background it and confirm it is up\",\"do\":[\"./boilerplate-cli-ui-machin daemon start --port 3000\",\"./boilerplate-cli-ui-machin daemon status --port 3000\"]},"
    s = s + "{\"goal\":\"expose it on the LAN with a kill switch that needs a token\",\"do\":[\"SHUTDOWN_TOKEN=s3cret ./boilerplate-cli-ui-machin serve --host 0.0.0.0 --port 8080\"]}"
    s = s + "],"
    s = s + "\"gotchas\":["
    s = s + "\"The UI is compiled in: editing ui/index.html does nothing until you rerun ./build.sh.\","
    s = s + "\"serve binds 127.0.0.1 by default. If you expected it on the LAN, pass --host 0.0.0.0 — and then set SHUTDOWN_TOKEN, or /_shutdown answers 403 to everyone.\","
    s = s + "\"daemon start is idempotent: called twice it reports the running instance instead of racing a second process onto the port.\","
    s = s + "\"daemon stop against a stopped daemon exits 0 — a no-op success, not an error.\","
    s = s + "\"Server confirmation lines go to stderr. An agent parsing stdout sees only data.\""
    s = s + "],"
    s = s + "\"see_also\":[\"https://cli-specs.intrane.fr\",\"https://github.com/javimosch/machin\"]"
    s = s + "}"
}

func guide_markdown() (s) {
    s = "# boilerplate-cli-ui-machin\n\n"
    s = s + "A CLI with an embedded web UI, written in machin (MFL) and compiled to one\n"
    s = s + "native binary that links only libc.\n\n"
    s = s + "## Model\n\n"
    s = s + "- One executable: no runtime, no interpreter, no node_modules.\n"
    s = s + "- A self-contained HTTP server, one goroutine per connection.\n"
    s = s + "- The UI is a string compiled into the binary (see src/ui_gen.src).\n"
    s = s + "- Agent-first: data on stdout, context on stderr, semantic exit codes.\n\n"
    s = s + "## Loop\n\n"
    s = s + "1. `./build.sh`\n"
    s = s + "2. `./boilerplate-cli-ui-machin serve`\n"
    s = s + "3. Open http://127.0.0.1:8080/ or curl /api/status.\n"
    s = s + "4. `./boilerplate-cli-ui-machin daemon start` to background it.\n"
    s = s + "5. `./boilerplate-cli-ui-machin daemon stop` to stop it.\n\n"
    s = s + "## Commands\n\n"
    s = s + "- `serve [--host H] [--port N]`\n"
    s = s + "- `daemon start|stop|status [--port N]`\n"
    s = s + "- `guide [--human]`, `help-json`, `version [--json]`\n\n"
    s = s + "## Gotchas\n\n"
    s = s + "- The UI is compiled in: rerun `./build.sh` after editing `ui/index.html`.\n"
    s = s + "- `serve` binds 127.0.0.1 by default; `--host 0.0.0.0` is deliberate.\n"
    s = s + "- Off-loopback, `POST /_shutdown` needs `X-Shutdown-Token` = `$SHUTDOWN_TOKEN`.\n"
    s = s + "- `daemon start` twice is idempotent; `daemon stop` when stopped exits 0.\n"
}

func llms_txt() (s) {
    s = "# boilerplate-cli-ui-machin\n\n"
    s = s + "A CLI with an embedded web UI in machin (MFL). One native binary.\n\n"
    s = s + "## Drive it\n\n"
    s = s + "    boilerplate-cli-ui-machin serve [--host H] [--port N]\n"
    s = s + "    boilerplate-cli-ui-machin daemon start|stop|status [--port N]\n\n"
    s = s + "JSON on stdout, context on stderr, exit 0/80-119.\n\n"
    s = s + "## Learn it\n\n"
    s = s + "    boilerplate-cli-ui-machin guide      # embedded, JSON\n"
    s = s + "    boilerplate-cli-ui-machin help-json  # command catalog\n\n"
    s = s + "HTTP: GET /  GET /api/status  GET /_health  POST /_shutdown  GET /guide\n"
}

func help_json() (s) {
    s = "{"
    s = s + "\"version\":\"1.0\","
    s = s + "\"tool\":\"boilerplate-cli-ui-machin\","
    s = s + "\"tool_version\":\"" + version() + "\","
    s = s + "\"commands\":["
    s = s + "{\"name\":\"serve\",\"summary\":\"run the HTTP server in the foreground\",\"flags\":[{\"name\":\"--host\",\"summary\":\"bind address\",\"default\":\"127.0.0.1\",\"env\":\"HOST\"},{\"name\":\"--port\",\"summary\":\"port\",\"default\":\"8080\",\"env\":\"PORT\"}]},"
    s = s + "{\"name\":\"daemon start\",\"summary\":\"start the server in the background (idempotent)\",\"flags\":[{\"name\":\"--port\",\"summary\":\"port\",\"default\":\"8080\"}]},"
    s = s + "{\"name\":\"daemon stop\",\"summary\":\"stop the background server (no-op success if stopped)\",\"flags\":[{\"name\":\"--port\",\"summary\":\"port\",\"default\":\"8080\"}]},"
    s = s + "{\"name\":\"daemon status\",\"summary\":\"report background server status\",\"flags\":[{\"name\":\"--port\",\"summary\":\"port\",\"default\":\"8080\"}]},"
    s = s + "{\"name\":\"guide\",\"summary\":\"the embedded operator guide\",\"flags\":[{\"name\":\"--human\",\"summary\":\"markdown instead of JSON\"}]},"
    s = s + "{\"name\":\"help-json\",\"summary\":\"this machine-readable command catalog\"},"
    s = s + "{\"name\":\"version\",\"summary\":\"print the version\",\"flags\":[{\"name\":\"--json\",\"summary\":\"JSON output\"}]}"
    s = s + "],"
    s = s + "\"endpoints\":["
    s = s + "{\"method\":\"GET\",\"path\":\"/\",\"summary\":\"the embedded web UI\"},"
    s = s + "{\"method\":\"GET\",\"path\":\"/api/status\",\"summary\":\"app status JSON\"},"
    s = s + "{\"method\":\"GET\",\"path\":\"/_health\",\"summary\":\"liveness: {ok,service,pid}\"},"
    s = s + "{\"method\":\"POST\",\"path\":\"/_shutdown\",\"summary\":\"stop the server; token-gated off-loopback\"},"
    s = s + "{\"method\":\"GET\",\"path\":\"/guide\",\"summary\":\"the guide over HTTP\"},"
    s = s + "{\"method\":\"GET\",\"path\":\"/llms.txt\",\"summary\":\"the short agent-facing README\"}"
    s = s + "],"
    s = s + "\"exit_codes\":{"
    s = s + "\"0\":\"success\","
    s = s + "\"85\":\"unknown command\","
    s = s + "\"90\":\"precondition failed (port unavailable, forbidden)\","
    s = s + "\"100\":\"external failure (the daemon did not answer)\""
    s = s + "},"
    s = s + "\"env\":[{\"name\":\"PORT\",\"summary\":\"default port\"},{\"name\":\"HOST\",\"summary\":\"default bind address\"},{\"name\":\"SHUTDOWN_TOKEN\",\"summary\":\"required by POST /_shutdown when bound off-loopback\"}],"
    s = s + "\"see_also\":[\"boilerplate-cli-ui-machin guide\",\"https://cli-specs.intrane.fr\"]"
    s = s + "}"
}
